-- UNION ALL: a proven-empty first input does not make an unknown second input known
Expression ((Project names + Projection)) (rows: <unknown>, cost: <unknown>)
  Aggregating (rows: ~1.0)
    Union (rows: <unknown>)
      Expression ((Before GROUP BY + (Change column names to column identifiers + (Project names + Projection)))) (rows: ~0.0)
        Filter ((WHERE + Change column names to column identifiers)) (rows: ~0.0)
          ReadFromMergeTree (default.t_ua_empty) (rows: ~0.0)
      Expression ((Before GROUP BY + (Change column names to column identifiers + (Project names + Projection)))) (rows: <unknown>)
        Filter ((WHERE + Change column names to column identifiers)) (rows: <unknown>)
          ReadFromMergeTree (default.t_ua_unk) (rows: ~100.0)
-- inner join: a proven-empty side decides, the unknown other side does not matter
Expression ((Project names + Projection)) (rows: <unknown>, cost: <unknown>)
  Aggregating (rows: ~1.0)
    Expression (Before GROUP BY) (rows: ~0.0)
      JoinLogical (Local HashJoin  swapped) (rows: ~0.0)
        Filter (((Propagated equi-join filter + (Change column names to column identifiers + (Project names + Projection))) + (WHERE + Change column names to column identifiers))) (rows: ~0.0)
          ReadFromMergeTree (default.t_ua_unk) (rows: ~0.0)
        Expression ((Change column names to column identifiers + (Project names + Projection))) (rows: ~0.0)
          Filter ((WHERE + Change column names to column identifiers)) (rows: ~0.0)
            ReadFromMergeTree (default.t_ua_empty) (rows: ~0.0)
-- semi join over an empty other side: empty
Expression ((Project names + Projection)) (rows: <unknown>, cost: <unknown>)
  Aggregating (rows: ~1.0)
    Expression (Before GROUP BY) (rows: ~0.0)
      JoinLogical (Local HashJoin ) (rows: ~0.0)
        Expression (Change column names to column identifiers) (rows: ~1000.0)
          ReadFromMergeTree (default.t_ua_known) (rows: ~1000.0)
        Expression ((Change column names to column identifiers + (Project names + Projection))) (rows: ~0.0)
          Filter ((WHERE + Change column names to column identifiers)) (rows: ~0.0)
            ReadFromMergeTree (default.t_ua_empty) (rows: ~0.0)
-- aggregation of an unknown input: keyless is one row, keyed is unknown
Expression ((Project names + Projection)) (rows: <unknown>, cost: <unknown>)
  Aggregating (rows: ~1.0)
    Expression (Before GROUP BY) (rows: <unknown>)
      Filter ((WHERE + Change column names to column identifiers)) (rows: <unknown>)
        ReadFromMergeTree (default.t_ua_unk) (rows: ~100.0)
Expression ((Project names + Projection)) (rows: <unknown>, cost: <unknown>)
  Aggregating (rows: <unknown>)
    Expression (Before GROUP BY) (rows: <unknown>)
      Filter ((WHERE + Change column names to column identifiers)) (rows: <unknown>)
        ReadFromMergeTree (default.t_ua_unk) (rows: ~100.0)
-- left any join: the left side
Expression ((Project names + Projection)) (rows: <unknown>, cost: <unknown>)
  Aggregating (rows: ~1.0)
    Expression (Before GROUP BY) (rows: ~1000.0)
      JoinLogical (Local HashJoin ) (rows: ~1000.0)
        Expression (Change column names to column identifiers) (rows: ~1000.0)
          ReadFromMergeTree (default.t_ua_known) (rows: ~1000.0)
        Expression (Change column names to column identifiers) (rows: ~100.0)
          ReadFromMergeTree (default.t_ua_unk) (rows: ~100.0)
