-- `grace_hash` needs a spill threshold, which `max_bytes_ratio_before_external_join` no longer provides by default.
SET max_bytes_ratio_before_external_join = 0.5;

{% for join_algorithm in ['default', 'full_sorting_merge', 'hash', 'partial_merge', 'grace_hash'] -%}

SET join_algorithm = '{{ join_algorithm }}';

SELECT deleted
FROM (
    SELECT 1 AS deleted, 'k' AS a, 'v' AS b
) AS q
INNER JOIN (
    SELECT 'k' AS a, 'v' AS c
) AS s
ON q.a = s.a
WHERE deleted AND (b = c);

{% endfor -%}

